{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simplex",
  "version": "0.33.0",
  "identifier": "de.simplex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simplex",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["sdoc", "sim", "swdoc"],
        "name": "Simplex-Dokument",
        "description": "Simplex-Dokument",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
